    "pi-dev",
    "pi-dev-mode",
    "skills",
    "workflow",
    "dev-workflow"
  ],
  "homepage": "https://github.com/ariesfish/pi-dev-mode",
  "repository": "https://github.com/ariesfish/pi-dev-mode",
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./pi/index.ts",
      "./pi/lifecycle.ts"
    ]
  },
  "peerDependencies": {
